# Supabase project settings (Project Settings > API). The anon key is designed to be public;
# never put a service-role key in browser code or in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Used for email links when no Origin header is present, e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# --- Server-only secrets (set in Vercel project settings; never commit real values; never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM="MMC Redesign <notifications@YOUR-VERIFIED-DOMAIN>"
OWNER_EMAIL=kashif.manhais@gmail.com
RATE_LIMIT_SALT=

# --- Optional public settings (safe to be public; set in Vercel when you have them) ---
# Class-booking WhatsApp contact. NOT the VIP channel. Leave empty until you have it; the button stays disabled.
NEXT_PUBLIC_CLASS_WHATSAPP_URL=
# VIP channel link. Optional: the code already contains your channel link as the default.
NEXT_PUBLIC_VIP_WHATSAPP_URL=
# Google sign-in is OPTIONAL. Set to true only AFTER enabling the Google provider in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
